# Supabase -> Project Settings -> Database -> Connection string (URI, port 6543 pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage (voice journals, license documents)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Speech-to-text: google | openai | mock
# Set MOCK_AI=true, or leave everything below blank, to run the Voice
# Journal end to end with simulated transcripts and analysis. The crisis
# escalation path works in mock mode too.
MOCK_AI=true
STT_PROVIDER=google

# Google Cloud Speech-to-Text V2 (chirp_2). Cebuano is served only from
# asia-southeast1, which the code sets for you. GOOGLE_APPLICATION_CREDENTIALS
# is the absolute path to the service account JSON key file — keep it out
# of the repo.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=C:/dev/openup/server/gcp-key.json

# Emotion analysis, and Whisper as a transcription fallback.
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Jitsi
JITSI_DOMAIN=meet.jit.si

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
